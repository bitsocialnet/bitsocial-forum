{
  "name": "bitsocial-forum",
  "version": "0.1.0",
  "private": true,
  "description": "Bitsocial Forum: a serverless, adminless forum client on the Bitsocial protocol, with sections that communities compete for.",
  "license": "GPL-3.0-or-later",
  "author": "Bitsocial Forge",
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --maxWorkers=4",
    "type-check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src && corepack yarn boundaries",
    "boundaries": "node scripts/check-module-boundaries.mjs",
    "prettier": "oxfmt 'src/**/*.{js,ts,tsx}' 'scripts/**/*.{js,mjs}'",
    "knip": "knip --production --include dependencies,unlisted,binaries --no-progress",
    "knip:full": "knip --no-progress --no-exit-code",
    "doctor": "react-doctor . -y",
    "deps:check-pinned": "node scripts/check-pinned-versions.mjs",
    "agent:verify": "node scripts/agent-verify.mjs",
    "ai-workflow:sync": "node scripts/sync-ai-workflow.mjs",
    "ai-workflow:check": "node scripts/validate-ai-workflow.mjs",
    "ai-workflow:test": "node --test --test-concurrency=1 scripts/__tests__/*.node-test.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@bitsocial/bitsocial-react-hooks": "0.1.58",
    "@playwright/cli": "0.1.22",
    "@radix-ui/react-slot": "1.2.4",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "agentation": "3.1.2",
    "assert": "2.1.0",
    "autoprefixer": "10.4.27",
    "babel-plugin-react-compiler": "1.0.0",
    "buffer": "6.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-spawn": "7.0.6",
    "crypto-browserify": "3.12.1",
    "cz-conventional-changelog": "3.3.0",
    "element-source": "0.0.5",
    "events": "3.3.0",
    "husky": "4.3.8",
    "i18next": "26.5.7",
    "isomorphic-fetch": "3.0.0",
    "js-yaml": "5.5.0",
    "jsdom": "30.1.3",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "lucide-react": "0.563.0",
    "oxc-parser": "0.152.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "portless": "0.11.1",
    "postcss": "8.5.23",
    "process": "0.11.10",
    "react": "19.3.1",
    "react-doctor": "0.9.18",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.5",
    "react-router-dom": "7.18.4",
    "rolldown": "1.2.15",
    "smol-toml": "1.9.1",
    "stream-browserify": "3.0.0",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "7.0.2",
    "util": "0.12.5",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "oxfmt --write"
    ],
    "scripts/**/*.{js,mjs}": [
      "oxfmt --write"
    ]
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "(exec < /dev/tty) 2>/dev/null && exec < /dev/tty && cz --hook || true",
      "pre-commit": "corepack yarn deps:check-pinned && lint-staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
